{
  "manifest_version": 3,
  "name": "치즈 플래터 - Chzzk Platter",
  "short_name": "ChzzkPlatter",
  "version": "1.44.0",
  "description": "치지직 검색, 플레이어, 오디오 믹서, 채팅, 팔로잉, 레이아웃을 한 접시에 담은 통합 편의 확장 프로그램",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "tabs",
    "storage",
    "scripting",
    "unlimitedStorage",
    "webRequest",
    "alarms",
    "downloads"
  ],
  "host_permissions": [
    "https://chzzk.naver.com/*",
    "https://m.naver.com/shorts/*",
    "https://studio.chzzk.naver.com/*",
    "https://api.chzzk.naver.com/*",
    "https://creatorhub-api.naver.com/*",
    "https://apis.naver.com/*",
    "https://comm-api.game.naver.com/*",
    "https://*.navercdn.com/*",
    "https://cafe.naver.com/*",
    "https://*.cafe.naver.com/*",
    "https://game.naver.com/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chzzk.naver.com/*",
        "https://studio.chzzk.naver.com/*",
        "https://game.naver.com/profile*"
      ],
      "exclude_matches": [
        "https://chzzk.naver.com/embed/clip/*",
        "https://chzzk.naver.com/clip-editor*"
      ],
      "js": ["src/masterGate.js"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "https://chzzk.naver.com/*",
        "https://studio.chzzk.naver.com/*",
        "https://game.naver.com/profile*"
      ],
      "exclude_matches": [
        "https://chzzk.naver.com/embed/clip/*",
        "https://chzzk.naver.com/clip-editor*"
      ],
      "js": ["src/coloris.min.js"],
      "css": ["src/coloris.min.css"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://chzzk.naver.com/*",
        "https://studio.chzzk.naver.com/*",
        "https://game.naver.com/profile*"
      ],
      "exclude_matches": [
        "https://chzzk.naver.com/embed/clip/*",
        "https://chzzk.naver.com/clip-editor*"
      ],
      "js": [
        "src/searchQuery.js",
        "src/chatRecapStore.js",
        "src/content.js",
        "src/subscribeBadge.js"
      ],
      "css": ["src/content.css", "src/chatFontScale.css"],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": ["https://chzzk.naver.com/*"],
      "js": ["src/logPowerPrediction.js"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": ["https://chzzk.naver.com/*"],
      "exclude_matches": [
        "https://chzzk.naver.com/embed/clip/*",
        "https://chzzk.naver.com/clip-editor*"
      ],
      "js": ["src/audioMixer.js", "src/videoFilter.js", "src/chatTimestamp.js"],
      "css": ["src/audioMixer.css", "src/videoFilter.css"],
      "run_at": "document_idle",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": ["https://chzzk.naver.com/clip-editor*"],
      "js": ["src/clipEditorBridge.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://chzzk.naver.com/clip-editor*"],
      "js": ["src/clipEditorEnhancer.js"],
      "css": ["src/clipEditorEnhancer.css"],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": ["https://chzzk.naver.com/*", "https://m.naver.com/shorts/*"],
      "exclude_matches": [
        "https://chzzk.naver.com/embed/clip/*",
        "https://chzzk.naver.com/clip-editor*"
      ],
      "js": ["src/clipButtonHide.js"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["https://m.naver.com/shorts/*"],
      "js": ["src/clipAudioMixer.js", "src/clipVideoFilter.js"],
      "css": ["src/clipAudioMixer.css", "src/clipVideoFilter.css"],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": ["https://chzzk.naver.com/*"],
      "exclude_matches": ["https://chzzk.naver.com/clip-editor*"],
      "js": ["src/clipFrameCoordinator.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://chzzk.naver.com/*"],
      "exclude_matches": [
        "https://chzzk.naver.com/embed/clip/*",
        "https://chzzk.naver.com/clip-editor*"
      ],
      "js": ["src/sidebarEarlyHide.js"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["https://chzzk.naver.com/*"],
      "exclude_matches": [
        "https://chzzk.naver.com/embed/clip/*",
        "https://chzzk.naver.com/clip-editor*"
      ],
      "js": ["src/commentBlock.js", "src/logPowerDonate.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": ["https://cafe.naver.com/*", "https://*.cafe.naver.com/*"],
      "js": ["src/cafeClipUrl.js", "src/cafeNow.js"],
      "css": ["src/cafeNow.css"],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": ["https://chzzk.naver.com/embed/clip/*"],
      "js": ["src/cafeClipPlayback.js"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["https://game.naver.com/profile*"],
      "js": ["src/profileClipSize.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://game.naver.com/profile*"],
      "js": ["src/logPowerEraser.js"],
      "css": ["src/logPowerEraser.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://game.naver.com/notify*"],
      "js": ["src/inboxCommunity.js", "src/inboxLogPower.js"],
      "css": ["src/inboxCommunity.css", "src/inboxLogPower.css"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "치즈 플래터",
    "default_popup": "settings.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "popup.html",
        "src/popup.css",
        "src/themeInit.js",
        "src/searchQuery.js",
        "src/popup.js",
        "no-search-results-found-animation.svg",
        "searching-animation.svg",
        "loading.svg",
        "logPowerStats.html",
        "src/logPowerStats.css",
        "src/logPowerStats.js",
        "chatRecap.html",
        "src/chatRecap.css",
        "src/chatRecapStore.js",
        "src/chatRecap.js",
        "src/chart.min.js",
        "src/coloris.min.js",
        "src/coloris.min.css"
      ],
      "matches": [
        "https://chzzk.naver.com/*",
        "https://studio.chzzk.naver.com/*",
        "https://game.naver.com/*"
      ]
    }
  ],
  "optional_host_permissions": [
    "https://nng-phinf.pstatic.net/*",
    "https://ssl.pstatic.net/*"
  ]
}
